+// Mind Palace fork: which team agent (legal | finance | eng) a scope is. LOCI_SCOPES is a JSON map
+// {"<scopeId>": "<agent>"}; the scope id's own ref (channel:legal) is the fallback.
+function lociScopeAgent(scope: ScopeId | undefined): string | undefined {
+  if (!scope) return undefined;
+  try {
+    const map = JSON.parse(process.env.LOCI_SCOPES || "{}") as Record<string, string>;
+    if (map[scope]) return map[scope];
+  } catch {}
+  const ref = String(scope).slice(String(scope).indexOf(":") + 1);
+  return ["legal", "finance", "eng"].includes(ref) ? ref : undefined;
+}
